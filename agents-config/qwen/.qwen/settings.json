{
  "context": {
    "fileName": [
      "AGENTS.md",
      "QWEN.md"
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(rg:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(glab mr create:*)",
      "Bash(go get:*)",
      "Bash(npm install:*)",
      "Bash(pip install:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(terraform apply:*)",
      "Bash(git reset --hard:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(gh pr merge:*)",
      "Bash(glab mr merge:*)",
      "Bash(terraform destroy:*)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/.aws/credentials)",
      "Read(./**/credentials.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(edit|write_file)",
        "hooks": [
          {
            "type": "command",
            "command": "bash $QWEN_PROJECT_DIR/.claude/hooks/format-and-guard.sh pre-edit",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash $QWEN_PROJECT_DIR/.claude/hooks/format-and-guard.sh pre-bash",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "mcpServers": {}
}
