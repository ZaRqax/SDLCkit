{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "provider": {
    "selfhosted": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "Qwen3-Coder-Next": { "name": "Qwen3-Coder-Next" },
        "GLM-5.1": { "name": "GLM-5.1" }
      }
    }
  },
  "model": "selfhosted/Qwen3-Coder-Next",
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "uvx", "--from", "git+https://github.com/oraios/serena",
        "serena", "start-mcp-server",
        "--context", "agent", "--project-from-cwd",
        "--mode", "planning", "--mode", "editing"
      ],
      "environment": { "GOPRIVATE": "github.com/acme", "GITHUB_TOKEN": "{env:GITHUB_PAT}" },
      "enabled": true
    },
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian"],
      "environment": {
        "JIRA_URL": "{env:JIRA_URL}",
        "JIRA_USERNAME": "{env:JIRA_USERNAME}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}",
        "CONFLUENCE_URL": "{env:CONFLUENCE_URL}",
        "CONFLUENCE_USERNAME": "{env:CONFLUENCE_USERNAME}",
        "CONFLUENCE_API_TOKEN": "{env:CONFLUENCE_API_TOKEN}",
        "JIRA_PROJECTS_FILTER": "{env:JIRA_PROJECTS_FILTER}",
        "CONFLUENCE_SPACES_FILTER": "{env:CONFLUENCE_SPACES_FILTER}",
        "READ_ONLY_MODE": "{env:ATLASSIAN_READ_ONLY}",
        "ENABLED_TOOLS": "{env:ATLASSIAN_ENABLED_TOOLS}"
      },
      "enabled": true
    },
    "context7": { "type": "local", "command": ["npx", "-y", "@upstash/context7-mcp@latest"], "enabled": true },
    "sequential-thinking": { "type": "local", "command": ["npx", "-y", "@modelcontextprotocol/server-sequentialthinking"], "enabled": true },
    "git": { "type": "local", "command": ["uvx", "mcp-server-git", "--repository", "{env:WORKSPACE_ROOT}"], "enabled": true },
    "fetch": { "type": "local", "command": ["uvx", "mcp-server-fetch"], "enabled": true }
  }
}
