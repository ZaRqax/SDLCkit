# No environment variables are required for prompt/local-file work.
# Prefer platform-native authentication: gh auth login / glab auth login.
# Enable a provider explicitly before adding its optional credentials.
# SDLC_CONFIG=/absolute/path/to/.sdlc/workspace.yaml
# JIRA_URL=https://example.atlassian.net
# JIRA_USERNAME=your-service-account
# JIRA_API_TOKEN=load-from-secret-manager
# CONFLUENCE_URL=https://example.atlassian.net/wiki
# ATLASSIAN_READ_ONLY=true
# CONTEXT7_API_KEY=load-from-secret-manager
# GOPRIVATE=your-private-module-prefix  # optional Go projects only
# Never commit .env or paste credential values into run artifacts.
