{
  "_README": "MCP servers for pi. pi has NO native MCP — the kit DEFAULT is the `pi-mcp-adapter` package (declared in settings.json packages[]); the hand-rolled ./mcp-extension/ is a documented offline fallback. BOTH read THIS file (mcpServers format). pi-mcp-adapter reads it with precedence (later wins): ~/.config/mcp/mcp.json, ~/.pi/agent/mcp.json, .mcp.json, .pi/mcp.json — setup.sh copies this to ~/.pi/agent/mcp.json, so no `/mcp setup` is needed. `directTools` promotes hot tools to first-class (instant, no proxy); `lifecycle: lazy` spawns a server only on first use; `keep-alive` keeps Serena warm. Differences vs the root .mcp.json: Serena --context is `agent`, `filesystem` is included (open agents lack Claude's sandbox), and adapter keys (lifecycle/directTools/idleTimeout) are added. Run only ONE MCP layer at a time (adapter OR the fallback bridge).",
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--from", "git+https://github.com/oraios/serena",
        "serena", "start-mcp-server",
        "--context", "agent",
        "--project-from-cwd",
        "--mode", "planning",
        "--mode", "editing"
      ],
      "env": { "GOPRIVATE": "github.com/acme", "GITHUB_TOKEN": "${GITHUB_PAT}" },
      "lifecycle": "keep-alive",
      "directTools": ["find_symbol", "get_symbols_overview", "replace_symbol_body", "insert_after_symbol", "find_referencing_symbols"]
    },
    "atlassian": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "JIRA_URL", "-e", "JIRA_USERNAME", "-e", "JIRA_API_TOKEN",
        "-e", "CONFLUENCE_URL", "-e", "CONFLUENCE_USERNAME", "-e", "CONFLUENCE_API_TOKEN",
        "-e", "JIRA_PROJECTS_FILTER", "-e", "CONFLUENCE_SPACES_FILTER",
        "-e", "READ_ONLY_MODE", "-e", "ENABLED_TOOLS",
        "ghcr.io/sooperset/mcp-atlassian:latest"
      ],
      "env": {
        "JIRA_URL": "${JIRA_URL}",
        "JIRA_USERNAME": "${JIRA_USERNAME}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}",
        "CONFLUENCE_URL": "${CONFLUENCE_URL}",
        "CONFLUENCE_USERNAME": "${CONFLUENCE_USERNAME}",
        "CONFLUENCE_API_TOKEN": "${CONFLUENCE_API_TOKEN}",
        "JIRA_PROJECTS_FILTER": "${JIRA_PROJECTS_FILTER}",
        "CONFLUENCE_SPACES_FILTER": "${CONFLUENCE_SPACES_FILTER}",
        "READ_ONLY_MODE": "${ATLASSIAN_READ_ONLY}",
        "ENABLED_TOOLS": "${ATLASSIAN_ENABLED_TOOLS}"
      },
      "lifecycle": "lazy",
      "idleTimeout": 10
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "env": { "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}" },
      "directTools": ["resolve-library-id", "get-library-docs"],
      "lifecycle": "lazy"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequentialthinking"],
      "lifecycle": "lazy"
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "${WORKSPACE_ROOT}"],
      "lifecycle": "lazy"
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "lifecycle": "lazy"
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${WORKSPACE_ROOT}"],
      "lifecycle": "lazy"
    }
  }
}
