# Secrets & local config
.env
*.local.json
.claude/settings.local.json
agents-config/**/.env

# Serena: commit memories + project.yml, ignore the cache
.serena/cache/

# Optional JSON handoff mirror (canonical handoff is specs/<TASK_ID>-<slug>/handoff.md, committed)
handoff/*.json
!handoff/.gitkeep

# Optional graph/drift engine store
.kit/

# Per-agent configs generated by setup.sh (from agents-config/ + .claude/). Regenerate, don't commit.
/opencode.json
/crush.json
/.opencode/
/.qwen/
# omp needs no generated config (it reads .claude/ natively); ignore a local .omp/ of native overrides.
/.omp/

# Plugin-root mirror produced by ./setup.sh --plugin-mirror (regenerate, don't commit).
# Note: a toggled-off agent is parked as .claude/agents/<name>.md.disabled — that rename IS tracked
# on purpose (your pipeline roster stays legible in git); only the generated mirror below is ignored.
/agents/
/commands/
/hooks/

# Local workspace overrides, ownership backups and durable run state (profiles are shareable).
**/.sdlc/local.yaml
**/.sdlc/local.json
**/.sdlc/runs/
**/.sdlc/deliveries/
**/.sdlc/backups/
**/.sdlc/generated-manifest.json
**/.sdlc/install-journal.json
**/.sdlc/*.lock
**/.sdlc/*.sqlite*
**/.sdlc/*.db*

# Python bytecode (from port-*.py / check-kit py_compile)
__pycache__/
*.pyc

# OS / editor
.DS_Store
*.swp
