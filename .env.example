# ─────────────────────────────────────────────────────────────────────────────
# SDLC kit — environment template.  Copy to `.env` (gitignored) and fill in.
# Loaded by setup.sh and exported into the MCP server processes. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Workspace root (used by the git + filesystem MCP servers) -----------------
WORKSPACE_ROOT=~/work/acme

# --- GitHub PAT (lets Serena/gopls index private github.com/acme modules) --
# Without this, Serena's find_symbol / find_referencing_symbols return empty on
# private modules. Needs `repo` + `read:packages` scope.
GITHUB_PAT=

# --- Atlassian / Jira + Confluence (read-write service-account profile) ---------
# Default profile is READ-WRITE via a shared SERVICE ACCOUNT so agents can create,
# update, transition, and comment on Jira issues and write Confluence pages.
# To run READ-ONLY instead, set ATLASSIAN_READ_ONLY=true (overrides ENABLED_TOOLS
# for any write tool) and use a per-developer token.
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=sdlc-bot@acme.com          # service-account email
JIRA_API_TOKEN=                                # https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_USERNAME=sdlc-bot@acme.com
CONFLUENCE_API_TOKEN=
JIRA_PROJECTS_FILTER=PROJ,TEAM                   # scope JQL/actions to these project keys
CONFLUENCE_SPACES_FILTER=                       # e.g. DEV,TEAM (blank = all visible)
ATLASSIAN_READ_ONLY=false                       # set true for a safe read-only profile
# ATLASSIAN_ENABLED_TOOLS=...                    # override the tool allowlist (see .mcp.json default)

# --- context7 (optional free key raises rate limits) ----------------------------
CONTEXT7_API_KEY=

# --- Open-model serving endpoint (OpenAI-compatible /v1) ------------------------
# Co-primary defaults: GLM-5.1 and Qwen3-Coder-Next. Point these at your serving
# stack (self-hosted vLLM/SGLang) or a hosted provider (z.ai / DeepInfra / Together).
# See agents-config/sampling-params.md for the per-model sampling settings.
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=sk-local
OPENAI_MODEL=qwen3-coder-next                   # or: glm-4.6 / glm-5.1 / <your served id>

# --- Optional: Postgres MCP (DB work only; per-service DB) -----------------------
# DATABASE_URI=postgresql://homestead:secret@localhost:15000/catalog
