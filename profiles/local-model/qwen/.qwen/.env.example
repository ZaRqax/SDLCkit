# Qwen Code — OpenAI-compatible endpoint for the open model.
# Copy to .qwen/.env in the project (or your home). OPENAI_BASE_URL MUST end in /v1.
#
# Option A — self-hosted (vLLM / SGLang / llama.cpp server on your box):
OPENAI_API_KEY=sk-local
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_MODEL=qwen3-coder-next        # or glm-5.1
#
# Option B — a hosted OpenAI-compatible provider (comment Option A, uncomment ONE block):
#   z.ai (GLM):   OPENAI_BASE_URL=https://api.z.ai/api/paas/v4        OPENAI_MODEL=glm-5.1
#   Together:     OPENAI_BASE_URL=https://api.together.xyz/v1          OPENAI_MODEL=<together-model-id>
#   DeepInfra:    OPENAI_BASE_URL=https://api.deepinfra.com/v1/openai  OPENAI_MODEL=<model-id>
#   OpenRouter:   OPENAI_BASE_URL=https://openrouter.ai/api/v1         OPENAI_MODEL=<vendor/model>
# Set OPENAI_API_KEY to the provider key. Any OpenAI-compatible /v1 endpoint works.

# Also export the kit's MCP/Jira/Serena env (or `source ../../.env`) so ${VAR} in settings.json
# resolves: GITHUB_PAT, JIRA_*, CONFLUENCE_*, JIRA_PROJECTS_FILTER, ATLASSIAN_READ_ONLY,
# ATLASSIAN_ENABLED_TOOLS, CONTEXT7_API_KEY, WORKSPACE_ROOT.
