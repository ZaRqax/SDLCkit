{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "roles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "model": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          }
        }
      }
    }
  }
}
