#!/usr/bin/env bash
# Commit-time safeguards supplement native provider permissions; they are not a sandbox.
set -euo pipefail
git diff --cached --check
python3 - <<'PY'
from pathlib import PurePosixPath
import re
import subprocess
import sys
files = subprocess.check_output(['git', 'diff', '--cached', '--name-only', '-z', '--diff-filter=ACM']).split(b'\0')
for raw in files:
    if not raw:
        continue
    path = raw.decode()
    name = PurePosixPath(path).name
    if name == '.env' or (name.startswith('.env.') and not name.endswith('.example')) or name in {'id_rsa', 'id_ed25519'}:
        sys.exit('pre-commit: secret file staged: ' + path)
    content = subprocess.check_output(['git', 'show', ':' + path])
    if re.search(rb'(?m)^-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----\r?$', content):
        sys.exit('pre-commit: private key content staged: ' + path)
PY
if [ -f scripts/check_kit.py ] && [ -d sdlc ]; then
  bash scripts/check-kit.sh
fi
printf 'Commit safeguards passed.\n'
