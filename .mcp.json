{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--from", "git+https://github.com/oraios/serena",
        "serena", "start-mcp-server",
        "--context", "claude-code",
        "--project-from-cwd",
        "--mode", "planning",
        "--mode", "editing"
      ],
      "env": {
        "GOPRIVATE": "github.com/acme",
        "GITHUB_TOKEN": "${GITHUB_PAT}"
      }
    },
    "atlassian": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "JIRA_URL",
        "-e", "JIRA_USERNAME",
        "-e", "JIRA_API_TOKEN",
        "-e", "CONFLUENCE_URL",
        "-e", "CONFLUENCE_USERNAME",
        "-e", "CONFLUENCE_API_TOKEN",
        "-e", "JIRA_PROJECTS_FILTER",
        "-e", "CONFLUENCE_SPACES_FILTER",
        "-e", "READ_ONLY_MODE",
        "-e", "ENABLED_TOOLS",
        "ghcr.io/sooperset/mcp-atlassian:latest"
      ],
      "env": {
        "JIRA_URL": "${JIRA_URL:-https://your-org.atlassian.net}",
        "JIRA_USERNAME": "${JIRA_USERNAME}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}",
        "CONFLUENCE_URL": "${CONFLUENCE_URL:-https://your-org.atlassian.net/wiki}",
        "CONFLUENCE_USERNAME": "${CONFLUENCE_USERNAME}",
        "CONFLUENCE_API_TOKEN": "${CONFLUENCE_API_TOKEN}",
        "JIRA_PROJECTS_FILTER": "${JIRA_PROJECTS_FILTER:-PROJ,TEAM}",
        "CONFLUENCE_SPACES_FILTER": "${CONFLUENCE_SPACES_FILTER:-}",
        "READ_ONLY_MODE": "${ATLASSIAN_READ_ONLY:-false}",
        "ENABLED_TOOLS": "${ATLASSIAN_ENABLED_TOOLS:-jira_search,jira_get_issue,jira_get_transitions,jira_create_issue,jira_update_issue,jira_transition_issue,jira_add_comment,jira_add_worklog,confluence_search,confluence_get_page,confluence_create_page,confluence_update_page}"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequentialthinking"]
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "${WORKSPACE_ROOT:-.}"]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    }
  }
}
