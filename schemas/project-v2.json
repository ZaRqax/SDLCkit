{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "repository_root": {
          "type": "string",
          "minLength": 1
        },
        "languages": {},
        "instructions": {
          "enum": [
            "preserve_existing"
          ]
        },
        "stack": {
          "type": "object"
        },
        "relationship": {
          "type": "object",
          "properties": {
            "depends_on": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "branches": {
          "type": "object",
          "properties": {
            "base": {
              "type": "string",
              "minLength": 1
            },
            "naming": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "commands": {
          "type": "object",
          "properties": {
            "format": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "lint": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "test": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "build": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "codegen": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [],
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "generated_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "policy": {
          "type": "object"
        },
        "verification": {
          "type": "object"
        },
        "agent": {
          "type": "object"
        },
        "workflow": {
          "type": "object"
        },
        "delivery": {
          "type": "object"
        },
        "parallelism": {
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "project"
  ],
  "additionalProperties": false
}
