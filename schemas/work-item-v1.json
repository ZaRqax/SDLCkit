{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLCkit WorkItem v1",
  "type": "object",
  "required": [
    "schema_version",
    "work_id",
    "title",
    "type",
    "goal",
    "acceptance_criteria",
    "sources",
    "external_references",
    "affected_projects",
    "unknowns",
    "requested_delivery"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "work_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,100}$"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref",
          "revision",
          "retrieved_at",
          "title",
          "body",
          "metadata",
          "trust"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "trust": {
            "const": "untrusted_evidence"
          }
        }
      }
    },
    "external_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        }
      }
    },
    "affected_projects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_delivery": {
      "enum": [
        "report",
        "working_tree",
        "patch",
        "commit",
        "local_branch",
        "github_pr",
        "gitlab_mr"
      ]
    }
  }
}
